.renderer-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(24, 65, 61); }
.renderer-widget { position: absolute; left: 53%; top: 22%; width: 39%; height: 17%; background-color: rgb(248, 246, 234); padding: 12px; justify-content: center; align-items: center; }
.renderer-element-widget { top: 41%; }
.renderer-data-widget { top: 60%; }
.renderer-caption { position: absolute; left: 8%; top: 15%; width: 84%; height: 19%; font-size: 20px; -unity-text-align: middle-center; }
.renderer-message { position: absolute; left: 6%; top: 38%; width: 88%; height: 50%; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.renderer-input { position: absolute; left: 20%; top: 84%; width: 60%; height: 50px; font-size: 20px; }
.narrow .renderer-widget { left: 7%; top: 44%; width: 86%; height: 10%; }
.narrow .renderer-element-widget { top: 55%; }
.narrow .renderer-data-widget { top: 66%; }
.narrow .renderer-message { font-size: 28px; }
.narrow .renderer-caption { font-size: 18px; }
.narrow .renderer-input { top: 81%; left: 7%; width: 86%; }
