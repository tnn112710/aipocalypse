.tutorial-root {
    flex-grow: 1;
    padding: 54px 78px 48px 78px;
    background-color: rgb(14, 17, 23);
    color: rgb(242, 245, 255);
}

.compatibility-root {
    padding-top: 42px;
    padding-bottom: 30px;
}

.compatibility-root .lesson-title {
    font-size: 36px;
}

.compatibility-root .stage {
    min-height: 390px;
}

.lesson-badge {
    color: rgb(71, 199, 224);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.lesson-title {
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.lesson-summary {
    color: rgb(186, 204, 224);
    font-size: 20px;
    margin-bottom: 22px;
    white-space: normal;
}

.stage {
    flex-grow: 1;
    min-height: 430px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: rgba(23, 29, 40, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(71, 199, 224, 0.35);
    border-right-color: rgba(71, 199, 224, 0.35);
    border-top-color: rgba(71, 199, 224, 0.35);
    border-bottom-color: rgba(71, 199, 224, 0.35);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.modern-label,
.compatibility-label {
    width: 78%;
    height: 270px;
    font-size: 58px;
    color: rgb(235, 247, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.stage-caption {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 18px;
    color: rgb(126, 166, 190);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.status {
    color: rgb(186, 204, 224);
    font-size: 18px;
    margin-top: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.control-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

.control-button {
    width: 180px;
    height: 44px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 18px;
    color: rgb(242, 245, 255);
    background-color: rgb(41, 56, 76);
    border-left-color: rgba(71, 199, 224, 0.5);
    border-right-color: rgba(71, 199, 224, 0.5);
    border-top-color: rgba(71, 199, 224, 0.5);
    border-bottom-color: rgba(71, 199, 224, 0.5);
}
