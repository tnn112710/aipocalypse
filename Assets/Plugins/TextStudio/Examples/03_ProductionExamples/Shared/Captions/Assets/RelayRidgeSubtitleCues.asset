  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76daa2125f6ac71438ac522779480caf, type: 3}
  m_Name: RelayRidgeSubtitleCues
  m_EditorClassIdentifier: TextStudio.Examples.Production::TextStudio.Examples.Production.TextStudioSubtitleCueSheet
  _cues:
  - _speaker: "MARA  \u2022  COMMS"
    _text: The storm is moving faster than predicted.<wait=.25> <em>Reach the relay
      before the ridge disappears.</em>
  - _speaker: "ENGINEER  \u2022  OFF-SCREEN"
    _text: <em>Copy that.</em> I can keep the eastern gate open for another thirty
      seconds.
  - _speaker: ENVIRONMENT
    _text: <color=#FFD77A>[ metal door slams ]</color>
  - _speaker: "MARA  \u2022  COMMS"
    _text: If the caption changes during reveal, <em>the newest gameplay line replaces
      it cleanly.</em>
  - _speaker: "MARA  \u2022  FR"
    _text: "La temp\xEAte arrive.<wait=.25> <em>Rejoignez le relais avant que la
      cr\xEAte ne disparaisse.</em>"
  - _speaker: "ENGINEER  \u2022  DE"
    _text: Das Tor bleibt offen.<wait=.25> <em>Erreicht die Relaisstation, bevor
      der Sturm aufzieht.</em>
