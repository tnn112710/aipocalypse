.whisperwood-root {
    flex-grow: 1;
    background-color: rgb(7, 10, 12);
    overflow: hidden;
}

.map-viewport {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 10%;
    bottom: 13%;
    align-items: center;
    justify-content: center;
}

.world {
    flex-shrink: 0;
    background-image: url('../Art/whisperwood_map.png');
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(224, 197, 130, 0.4);
    border-right-color: rgba(224, 197, 130, 0.4);
    border-top-color: rgba(224, 197, 130, 0.4);
    border-bottom-color: rgba(224, 197, 130, 0.4);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.world-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.14);
}

.token {
    position: absolute;
    width: 34px;
    height: 34px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.65);
    border-right-color: rgba(255, 255, 255, 0.65);
    border-top-color: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(255, 255, 255, 0.65);
}

.player-token {
    width: 28px;
    height: 28px;
    background-color: rgb(255, 235, 108);
}

.gate-token {
    width: 54px;
    height: 54px;
    background-color: rgba(107, 122, 148, 0.86);
}

.mara-token { background-color: rgb(235, 133, 71); }
.luma-token { background-color: rgb(117, 219, 245); }
.rowan-token { background-color: rgb(224, 194, 255); }

.npc-label {
    position: absolute;
    left: -45px;
    top: 38px;
    width: 124px;
    height: 30px;
    font-size: 17px;
    color: white;
    -unity-text-align: middle-center;
    background-color: rgba(8, 10, 12, 0.82);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.menu-composition {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 10%;
    bottom: 13%;
    align-items: center;
    justify-content: center;
}

.title-slot { width: 100%; max-width: 1200px; height: 100px; flex-shrink: 0; margin-bottom: 16px; }
.parchment-slot { width: 100%; max-width: 1000px; height: 340px; flex-shrink: 0; margin-bottom: 16px; }
.buttons-slot { width: 100%; max-width: 760px; height: 72px; flex-shrink: 0; }

.title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 52px;
    -unity-font-definition: url('../../../../Runtime/Fonts/Appearance/CinzelDecorative-Bold/CinzelDecorative-Bold.ttf');
    color: rgb(255, 235, 168);
    -unity-text-align: middle-center;
}

.hud {
    position: absolute;
    left: 5%;
    top: 1%;
    width: 31%;
    height: 58px;
    font-size: 20px;
    color: rgb(219, 240, 255);
    -unity-text-align: middle-left;
}

.quest {
    position: absolute;
    right: 5%;
    top: 1%;
    width: 30%;
    height: 70px;
    font-size: 20px;
    color: rgb(230, 255, 209);
    -unity-text-align: middle-right;
}

.nearby {
    position: absolute;
    left: 34%;
    right: 34%;
    bottom: 13%;
    height: 42px;
    font-size: 22px;
    color: rgb(255, 235, 166);
    -unity-text-align: middle-center;
}

.prompt {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 5%;
    height: 44px;
    font-size: 22px;
    color: rgb(230, 245, 255);
    -unity-text-align: middle-center;
}

.gate-sign {
    position: absolute;
    left: -123px;
    top: -40px;
    width: 300px;
    height: 32px;
    font-size: 22px;
    color: rgb(219, 240, 255);
    -unity-text-align: middle-center;
}

.parchment-panel {
    position: absolute;
    background-image: url('../Art/whisperwood_panel.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(244, 225, 179, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.menu-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.menu-body {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 20%;
    bottom: 20%;
    font-size: 28px;
    color: rgb(51, 33, 20);
    white-space: normal;
    -unity-text-align: middle-center;
}

.menu-button-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.menu-button {
    position: absolute;
    top: 8px;
    height: 48px;
    color: white;
    background-color: rgb(78, 58, 39);
    font-size: 19px;
}

.start-button { left: 14%; width: 28%; }
.credits-button { left: 58%; width: 28%; }
.resume-button { left: 3%; width: 25%; }
.restart-button { left: 37.5%; width: 25%; }

.dialogue-panel {
    left: 8%;
    right: 8%;
    top: 72%;
    bottom: 4%;
}

.speaker {
    position: absolute;
    left: 12%;
    right: 32%;
    top: 25%;
    height: 38px;
    font-size: 24px;
    color: rgb(51, 31, 15);
    -unity-text-align: middle-left;
}

.dialogue {
    position: absolute;
    left: 12%;
    right: 31%;
    top: 40%;
    height: 92px;
    font-size: 25px;
    color: rgb(41, 24, 11);
    white-space: normal;
    -unity-text-align: upper-left;
}

.dialogue-button {
    position: absolute;
    right: 12%;
    width: 14%;
    height: 42px;
    color: white;
    background-color: rgb(78, 58, 39);
}

.continue-button { top: 30%; }
.skip-button { top: 58%; }

.credits-panel {
    left: 24%;
    right: 24%;
    top: 28%;
    bottom: 26%;
}

.credits-copy {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 12%;
    bottom: 19%;
    font-size: 27px;
    color: rgb(46, 26, 13);
    white-space: normal;
    -unity-text-align: middle-center;
}

.lantern {
    position: absolute;
    width: 24px;
    height: 34px;
    background-color: rgb(51, 41, 26);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(66, 49, 29);
    border-right-color: rgb(66, 49, 29);
    border-top-color: rgb(66, 49, 29);
    border-bottom-color: rgb(66, 49, 29);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}
.journal-button {
    position: absolute;
    left: 45%;
    width: 10%;
    top: 2%;
    height: 44px;
    font-size: 20px;
    color: white;
    background-color: rgb(78, 58, 39);
}
/* Choices reuse the Continue and Skip rows and stay inside the paper, mirroring the text's left inset. */
.choice-button {
    position: absolute;
    left: 71%;
    right: 12%;
    height: 42px;
    font-size: 18px;
    color: white;
    background-color: rgb(78, 58, 39);
}
.ask-button { top: 30%; }
.leave-button { top: 58%; }
.journal-back-button {
    position: absolute;
    left: 39%;
    width: 22%;
    bottom: 5%;
    height: 42px;
    font-size: 20px;
    color: white;
    background-color: rgb(78, 58, 39);
}

.sound-button {
    position: absolute;
    left: 58%;
    width: 11%;
    top: 2%;
    height: 44px;
    font-size: 18px;
    color: white;
    background-color: rgb(78, 58, 39);
}

.finale-panel {
    position: absolute;
    left: 10%; right: 10%; top: 22%; bottom: 25%;
    background-color: rgba(12, 24, 28, 0.98);
    border-width: 1px;
    border-color: rgb(142, 121, 76);
    align-items: center;
    justify-content: center;
    display: none;
}
.finale-heading { font-size: 48px; color: rgb(255, 220, 138); margin-bottom: 24px; }
.inscription { font-size: 46px; color: rgb(255, 220, 138); white-space: normal; -unity-text-align: middle-center; width: 84%; }
.finale-reward { font-size: 28px; color: rgb(230, 245, 217); margin-top: 24px; margin-bottom: 24px; }
.finale-continue-button { width: 40%; min-height: 44px; font-size: 20px; color: rgb(255, 246, 225); background-color: rgb(78, 58, 39); }

.clue-button {
    position: absolute;
    left: 12%; top: 67%; width: 54%; height: 13%;
    min-height: 28px;
    font-size: 18px;
    color: rgb(51, 31, 15);
    background-color: rgba(171, 138, 77, 0.4);
}
