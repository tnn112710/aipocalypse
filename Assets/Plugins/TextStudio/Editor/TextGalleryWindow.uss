.ts-gallery {
    min-width: 0;
    min-height: 0;
}

.ts-gallery-icon-button {
    width: 26px;
    min-width: 26px;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    align-items: center;
    justify-content: center;
}

.ts-gallery-action-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ts-gallery-card {
    background-color: var(--unity-colors-default-background);
    border-left-color: var(--unity-colors-window-border);
    border-right-color: var(--unity-colors-window-border);
    border-top-color: var(--unity-colors-window-border);
    border-bottom-color: var(--unity-colors-window-border);
    min-width: 0;
    overflow: hidden;
}

.ts-gallery .common-selectable-grid-view__item-selected .ts-gallery-card,
.ts-gallery .common-selectable-grid-view__item-selected.ts-gallery-card {
    border-left-color: var(--unity-colors-highlight-background);
    border-right-color: var(--unity-colors-highlight-background);
    border-top-color: var(--unity-colors-highlight-background);
    border-bottom-color: var(--unity-colors-highlight-background);
}

.ts-gallery .ts-style-card {
    border-width: 2px;
    border-radius: 6px;
    padding: 7px;
}

.ts-gallery .ts-style-card:hover {
    background-color: rgba(94, 94, 94, 0.52);
    border-color: rgba(170, 170, 170, 0.58);
}

.ts-gallery .common-selectable-grid-view__item-selected.ts-style-card {
    background-color: rgba(53, 119, 210, 0.20);
    border-color: rgb(74, 144, 236);
}

.ts-gallery .ts-style-grid--focused .common-selectable-grid-view__item-selected.ts-style-card {
    background-color: rgba(53, 119, 210, 0.36);
    border-color: rgb(156, 198, 249);
}

.ts-gallery-light .ts-style-card:hover {
    background-color: rgba(0, 0, 0, 0.07);
    border-color: rgba(55, 55, 55, 0.48);
}

.ts-gallery-light .common-selectable-grid-view__item-selected.ts-style-card {
    background-color: rgba(42, 108, 200, 0.14);
    border-color: rgb(42, 108, 200);
}

.ts-gallery-light .ts-style-grid--focused .common-selectable-grid-view__item-selected.ts-style-card {
    background-color: rgba(42, 108, 200, 0.24);
    border-color: rgb(23, 76, 149);
}

.ts-style-empty {
    margin: 12px;
    white-space: normal;
}
