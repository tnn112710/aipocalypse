.ts-inspector-root {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 10px;
    min-width: 0;
    flex-grow: 1;
}

.unity-inspector-element .ts-inspector-root {
    margin-left: -9px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 8px;
    padding-bottom: 0;
}

.ts-section {
    min-width: 0;
    margin-top: 6px;
    margin-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 7px;
    padding-bottom: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.50);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(255, 255, 255, 0.035);
}

.ts-section--titleless,
.ts-section-native-title,
.ts-section.common-inspector-section--titleless,
.ts-section.common-inspector-section--native-title {
    margin-top: 0;
    padding-top: 0;
}

.ts-section .ts-section,
.ts-section .ts-composed-group-card {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ts-section-title {
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.ts-section-foldout .unity-foldout__toggle {
    margin-bottom: 5px;
}

.ts-section-foldout .unity-toggle__text {
    -unity-font-style: bold;
}

.ts-inspector-root .unity-foldout {
    width: 100%;
    min-width: 0;
    flex-shrink: 1;
}

.ts-inspector-root .unity-foldout__toggle {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 1;
}

.ts-inspector-root .unity-foldout__content {
    min-width: 0;
    margin-left: 16px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 1;
}

.ts-preview-section {
    margin-top: 2px;
}

.ts-preview-section > .ts-section-title {
    padding-right: 32px;
}

.ts-text-inspector .ts-preview-section > .ts-section-title {
    min-height: 24px;
    padding-right: 156px;
}

.ts-preview-export-menu {
    position: absolute;
    right: 7px;
    top: 5px;
    width: 24px;
    min-width: 24px;
    height: 22px;
    min-height: 22px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.ts-preview-export-menu-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ts-preview-export-menu:hover,
.ts-preview-export-menu:focus,
.ts-preview-export-menu:active {
    background-color: rgba(0, 0, 0, 0);
}

.ts-preview-export-window {
    min-width: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 14px;
    background-color: rgb(40, 42, 48);
}

.ts-preview-export-title {
    margin-top: 3px;
    margin-bottom: 4px;
    font-size: 19px;
}

.ts-preview-export-copy {
    min-width: 0;
    white-space: normal;
    margin-bottom: 12px;
}

.ts-preview-export-choice-label {
    margin-left: 1px;
    margin-bottom: 5px;
    color: rgb(196, 201, 207);
    -unity-font-style: bold;
}

.ts-preview-export-format-row {
    flex-direction: row;
    min-width: 0;
    margin-left: -3px;
    margin-right: -3px;
    margin-bottom: 12px;
}

.ts-preview-export-renderer-row {
    flex-wrap: wrap;
}

.ts-preview-export-renderer-row > .ts-preview-export-format {
    min-width: 190px;
    min-height: 78px;
}

.ts-preview-export-format {
    flex-grow: 1;
    min-width: 0;
    min-height: 64px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 8px;
    padding-bottom: 8px;
    align-items: flex-start;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.45);
    background-color: rgba(0, 0, 0, 0.18);
}

.ts-preview-export-format-selected {
    border-left-color: rgba(82, 183, 255, 0.85);
    border-right-color: rgba(82, 183, 255, 0.85);
    border-top-color: rgba(82, 183, 255, 0.85);
    border-bottom-color: rgba(82, 183, 255, 0.85);
    background-color: rgba(35, 116, 173, 0.24);
}

.ts-preview-export-format-title {
    margin-bottom: 3px;
    font-size: 14px;
    -unity-font-style: bold;
}

.ts-preview-export-format-subtitle {
    min-width: 0;
    white-space: normal;
}

.ts-preview-export-details {
    min-width: 0;
    min-height: 46px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    white-space: normal;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.16);
}

.ts-preview-export-warning {
    min-width: 0;
    margin-top: 8px;
    color: rgb(242, 190, 91);
    white-space: normal;
}

.ts-preview-export-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.ts-preview-export-actions > Button {
    min-width: 124px;
    min-height: 36px;
    margin-left: 0;
    padding-top: 7px;
    padding-bottom: 7px;
}

.ts-effect-code-window {
    min-width: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 17px;
    padding-bottom: 14px;
    background-color: rgb(40, 42, 48);
}

.ts-effect-code-eyebrow {
    margin-bottom: 3px;
    font-size: 10px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.ts-effect-code-title {
    min-width: 0;
    margin-top: 0;
    margin-bottom: 5px;
    font-size: 20px;
    white-space: normal;
}

.ts-effect-code-copy {
    min-width: 0;
    margin-bottom: 19px;
    white-space: normal;
}

.ts-effect-code-window > .unity-base-field,
.ts-effect-code-destination-row {
    min-width: 0;
    margin-top: 3px;
    margin-bottom: 7px;
}

.ts-effect-code-input {
    height: 138px;
    min-width: 0;
    margin-bottom: 10px;
    white-space: normal;
}

.ts-effect-code-input .unity-base-text-field__input,
.ts-effect-code-input .unity-text-field__input,
.ts-effect-code-input .unity-text-input {
    white-space: normal;
}

.ts-effect-code-field-hint {
    min-width: 0;
    margin-left: 20.5%;
    margin-right: 0;
    margin-top: -5px;
    margin-bottom: 5px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.ts-effect-code-destination-row {
    flex-direction: row;
    align-items: center;
}

.ts-effect-code-browse {
    width: 34px;
    min-width: 34px;
    height: 24px;
    margin-left: 6px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

.ts-effect-code-preview {
    min-width: 0;
    margin-top: 7px;
    margin-bottom: 3px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 14px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0.16);
}

.ts-effect-code-preview-title {
    min-width: 0;
    margin-bottom: 4px;
    font-size: 14px;
    white-space: normal;
}

.ts-effect-code-preview-details {
    min-width: 0;
    white-space: normal;
    flex-shrink: 0;
}

.ts-effect-code-status {
    min-width: 0;
    margin-top: 9px;
}

.ts-effect-code-actions {
    align-items: stretch;
    justify-content: center;
}

.ts-effect-code-actions > Button {
    width: 100%;
    min-height: 36px;
    margin-left: 0;
    margin-right: 0;
    padding-top: 7px;
    padding-bottom: 7px;
    flex-grow: 1;
}

.ts-theme-light.ts-effect-code-window {
    background-color: rgb(221, 221, 221);
}

.ts-theme-light .ts-effect-code-preview {
    border-left-color: rgba(45, 55, 62, 0.18);
    border-right-color: rgba(45, 55, 62, 0.18);
    border-top-color: rgba(45, 55, 62, 0.18);
    border-bottom-color: rgba(45, 55, 62, 0.26);
    background-color: rgba(255, 255, 255, 0.48);
}

.ts-preview-mode-segmented {
    position: absolute;
    right: 7px;
    top: 5px;
    width: 142px;
    flex-direction: row;
    align-items: center;
}

.ts-preview-mode-segment-button {
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    margin-left: 0;
    margin-right: -1px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-left-color: rgba(255, 255, 255, 0.13);
    border-right-color: rgba(255, 255, 255, 0.13);
    border-top-color: rgba(255, 255, 255, 0.13);
    border-bottom-color: rgba(0, 0, 0, 0.42);
    color: rgb(190, 196, 202);
    background-color: rgba(0, 0, 0, 0.16);
}

.ts-preview-mode-segment-button:hover {
    color: rgb(225, 229, 233);
    border-left-color: rgba(132, 221, 209, 0.46);
    border-right-color: rgba(132, 221, 209, 0.46);
    border-top-color: rgba(132, 221, 209, 0.46);
    border-bottom-color: rgba(132, 221, 209, 0.46);
}

.ts-preview-mode-segment-first {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.ts-preview-mode-segment-last {
    margin-right: 0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ts-preview-mode-segment-active {
    color: rgb(238, 241, 244);
    border-left-color: rgba(132, 221, 209, 0.62);
    border-right-color: rgba(132, 221, 209, 0.62);
    border-top-color: rgba(132, 221, 209, 0.62);
    border-bottom-color: rgba(132, 221, 209, 0.62);
    background-color: rgba(69, 121, 116, 0.62);
    -unity-font-style: bold;
}

.ts-authoring-mode-active {
    color: rgb(238, 241, 244);
    background-color: rgba(132, 221, 209, 0.18);
    -unity-font-style: bold;
}

.ts-preview-live-body {
    min-width: 0;
    margin-top: 8px;
}

.ts-raw-source-panel {
    margin-top: 2px;
}

.ts-button-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 2px;
    margin-bottom: 4px;
}

.ts-preview-controls-row {
    min-height: 26px;
}

.ts-preview-command-separator {
    height: 1px;
    margin-top: 4px;
    margin-bottom: 7px;
    background-color: rgba(255, 255, 255, 0.08);
}

.ts-preview-command-row {
    margin-top: 0;
    margin-bottom: 2px;
}

.ts-button-row Button {
    min-height: 22px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.ts-preview-button {
    min-width: 52px;
}

.ts-composed-preview-scrub-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.ts-composed-preview-scrub-row > .ts-scrub-slider {
    flex-grow: 1;
    min-width: 0;
}

.ts-scrub-slider > .unity-base-field__label {
    width: 48px;
    min-width: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 6px;
}

.ts-scrub-slider > .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
}

.ts-composed-active-duration-button {
    flex-shrink: 0;
    min-width: 72px;
    min-height: 22px;
    margin-left: 6px;
}

.ts-preview-segment-row {
    flex-direction: row;
    align-items: stretch;
    margin-top: 2px;
    margin-bottom: 6px;
}

.ts-preview-segment-button {
    flex-grow: 1;
    min-width: 0;
    min-height: 24px;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    color: rgb(148, 154, 160);
    background-color: rgba(0, 0, 0, 0.12);
}

.ts-preview-segment-button:hover {
    color: rgb(224, 229, 233);
    border-left-color: rgba(132, 221, 209, 0.46);
    border-right-color: rgba(132, 221, 209, 0.46);
    border-top-color: rgba(132, 221, 209, 0.46);
    border-bottom-color: rgba(132, 221, 209, 0.46);
}

.ts-preview-segment-selected {
    color: rgb(231, 237, 239);
    border-left-color: rgba(132, 221, 209, 0.60);
    border-right-color: rgba(132, 221, 209, 0.60);
    border-top-color: rgba(132, 221, 209, 0.60);
    border-bottom-color: rgba(132, 221, 209, 0.60);
    background-color: rgba(132, 221, 209, 0.09);
    -unity-font-style: bold;
}

.ts-preview-segment-off {
    color: rgb(148, 154, 160);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    background-color: rgba(0, 0, 0, 0.14);
}

.ts-preview-segment-button:disabled {
    color: rgb(122, 127, 132);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(0, 0, 0, 0.24);
    background-color: rgba(0, 0, 0, 0.10);
}

.ts-preview-repeat-button {
    min-width: 86px;
}

.ts-default-effects-group {
    min-width: 0;
    align-items: stretch;
}

.ts-default-effects-mode-field {
    align-self: flex-start;
    width: 100%;
    max-width: 390px;
}

.ts-default-effects-mode-field .unity-base-field {
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
}

.ts-default-effects-mode-field .unity-base-field__label {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
    flex-grow: 0;
    flex-shrink: 0;
    white-space: normal;
}

.ts-default-effects-mode-field .unity-base-field__input {
    width: 200px;
    min-width: 120px;
    max-width: 220px;
    flex-grow: 1;
    flex-shrink: 1;
}

.ts-default-effects-expression-field {
    min-width: 0;
}

.ts-default-effects-expression-field .unity-base-field {
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

.ts-default-effects-expression-field .unity-base-field__label {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    white-space: normal;
}

.ts-default-effects-expression-field .unity-base-field__input {
    width: 100%;
    min-width: 0;
    margin-left: 0;
}

.ts-muted-text {
    margin-top: 2px;
    margin-bottom: 4px;
}

.ts-muted-text,
.ts-debug-summary {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    color: rgb(165, 170, 176);
}

.ts-emission-preset-format-preview {
    min-width: 0;
    margin-top: 10px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 9px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0.18);
}

.ts-emission-preset-format-preview > .ts-muted-text {
    margin-top: 0;
    margin-bottom: 3px;
}

.ts-emission-preset-format-preview-value {
    min-width: 0;
    white-space: normal;
    font-size: 14px;
}

.ts-ownership-badge {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin-top: 4px;
    margin-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0.16);
}

.ts-badge-title {
    color: rgb(145, 150, 156);
    min-width: 70px;
}

.ts-badge-value {
    flex-grow: 1;
    color: rgb(214, 218, 222);
}

.ts-badge-summary {
    flex-grow: 1;
    margin-right: 8px;
    color: rgb(255, 206, 128);
    white-space: normal;
    -unity-text-align: middle-right;
}

.ts-badge-state {
    min-width: 48px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-font-style: bold;
}

.ts-state-ready {
    color: rgb(140, 226, 179);
    background-color: rgba(68, 166, 116, 0.16);
}

.ts-state-warning {
    color: rgb(255, 206, 128);
    background-color: rgba(205, 136, 43, 0.16);
}

.ts-tab-pane {
    min-width: 0;
    margin-top: 6px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(0, 0, 0, 0.12);
}

.ts-tab-bar {
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ts-tab-toggle {
    flex-grow: 1;
    min-width: 0;
    min-height: 27px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: rgb(190, 196, 202);
    background-color: rgba(0, 0, 0, 0);
    -unity-font-style: normal;
}

.ts-tab-toggle:hover {
    color: rgb(225, 229, 233);
    background-color: rgba(255, 255, 255, 0.035);
}

.ts-tab-active {
    color: rgb(238, 241, 244);
    border-bottom-color: rgb(132, 221, 209);
    background-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
}

.ts-tab-body {
    flex-grow: 1;
    min-width: 0;
    padding-top: 4px;
}

.ts-tab-overflow-slot {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.09);
}

.ts-tab-overflow-button {
    width: 28px;
    min-width: 28px;
    min-height: 27px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: rgb(190, 196, 202);
    background-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
}

.ts-tab-overflow-button:hover {
    color: rgb(225, 229, 233);
    background-color: rgba(255, 255, 255, 0.035);
}

.ts-content-tab,
.ts-typewriter-tab,
.ts-placement-tab,
.ts-renderers-tab,
.ts-events-tab,
.ts-debug-tab {
    flex-grow: 1;
}

.ts-source-field {
    min-height: 82px;
    margin-top: 1px;
    margin-bottom: 6px;
    align-items: flex-start;
}

.ts-source-field-wrap {
    white-space: normal;
}

.ts-source-field > .unity-base-field__input {
    min-width: 0;
    min-height: 78px;
    flex-grow: 1;
    flex-shrink: 1;
}

.ts-source-field-wrap .unity-base-text-field__input,
.ts-source-field-wrap .unity-text-field__input,
.ts-source-field-wrap .unity-text-input {
    min-height: 74px;
    white-space: normal;
}

.ts-source-tag-color {
    color: rgb(165, 170, 176);
}

.ts-tag-inline-help {
    margin-top: -1px;
    margin-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(0, 0, 0, 0.36);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(0, 0, 0, 0.16);
}

.ts-tag-inline-help--details-only {
    padding-top: 5px;
}

.ts-tag-inline-help-suggestions {
    flex-shrink: 0;
}

.ts-tag-inline-help-row {
    flex-direction: row;
    align-items: stretch;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.ts-tag-inline-help-row-selected {
    background-color: rgba(132, 221, 209, 0.13);
}

.ts-tag-inline-help-tag-action {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.ts-tag-inline-help-tag-action:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.ts-tag-inline-help-tag-action:focus,
.ts-tag-inline-help-tag-action.ts-tag-inline-help-action-focused,
.ts-tag-inline-help-tag-action:active {
    background-color: rgba(132, 221, 209, 0.12);
}

.ts-tag-inline-help-tag-action:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
}

.ts-tag-inline-help-token {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(222, 226, 229);
    -unity-text-align: middle-left;
}

.ts-tag-inline-help-origin {
    flex-shrink: 0;
    max-width: 45%;
    margin-left: 8px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
