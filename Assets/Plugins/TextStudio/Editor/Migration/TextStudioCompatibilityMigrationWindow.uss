.ts-compatibility-migration-window {
    min-width: 0;
}

.ts-compatibility-migration-content {
    min-width: 0;
    flex-grow: 1;
}

.ts-compatibility-migration-content .unity-scroll-view__content-container {
    min-width: 0;
    padding-bottom: 4px;
}

.ts-migration-introduction {
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 3px;
    margin-bottom: 8px;
    font-size: 12px;
}

.ts-migration-markup-field {
    min-width: 0;
    min-height: 76px;
    align-items: flex-start;
}

.ts-migration-markup-field > .unity-base-field__label {
    padding-top: 4px;
    white-space: normal;
}

.ts-migration-markup-field > .unity-base-field__input {
    min-width: 0;
    min-height: 72px;
    flex-grow: 1;
    flex-shrink: 1;
}

.ts-migration-markup-field .unity-text-field__input {
    min-height: 68px;
    white-space: normal;
}

.ts-migration-section-actions {
    margin-top: 6px;
    margin-bottom: 0;
}

.ts-migration-project-wizard {
    padding-left: 8px;
    border-left-width: 3px;
    border-left-color: rgba(132, 221, 209, 0.68);
}

.ts-migration-primary-action {
    width: 100%;
    min-height: 30px;
    margin-top: 6px;
    white-space: normal;
}

#ts-migration-status {
    margin-top: 6px;
    margin-bottom: 2px;
}

#ts-migration-selection-status {
    margin-bottom: 6px;
}

.common-inspector--compact .ts-migration-markup-field {
    flex-direction: column;
    align-items: stretch;
}

.common-inspector--compact .ts-migration-markup-field > .unity-base-field__label {
    width: auto;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 2px;
    padding-top: 0;
}

.common-inspector--compact .ts-migration-markup-field > .unity-base-field__input {
    width: 100%;
}
