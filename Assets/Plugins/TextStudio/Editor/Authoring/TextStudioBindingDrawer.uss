.ts-uitk-binding-drawer {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.unity-inspector-element .ts-uitk-binding-drawer {
    margin-left: 0;
    margin-right: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 10px;
}

.ts-uitk-binding-segmented {
    flex-direction: row;
    margin-top: 1px;
    margin-bottom: 6px;
}

.ts-uitk-binding-segment-button {
    flex-grow: 1;
    min-width: 54px;
    height: 23px;
    margin: 0;
    border-radius: 0;
}

.ts-uitk-binding-segment-first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.ts-uitk-binding-segment-last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.ts-uitk-binding-segment-active {
    background-color: rgba(62, 133, 201, 0.56);
    color: white;
}

.ts-uitk-binding-source-body {
    min-width: 0;
    margin-top: 1px;
}

.ts-uitk-binding-picker-row {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 5px;
}

.ts-uitk-binding-picker-row > Button {
    min-width: 0;
    margin: 0;
}

.ts-uitk-binding-link-badge,
.ts-uitk-binding-limitation-badge {
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 9px;
    padding: 3px 6px;
    border-radius: 3px;
}

.ts-uitk-binding-link-badge {
    margin-right: 6px;
    background-color: rgba(62, 133, 201, 0.18);
    color: rgb(118, 184, 239);
}

#ts-uitk-live-preview-status {
    margin-bottom: 5px;
}

#ts-uitk-live-preview-status.ts-uitk-live-preview-connected {
    color: rgb(116, 211, 183);
}

.ts-uitk-binding-diagnostics > * {
    margin-bottom: 3px;
}

.ts-uitk-event-row {
    align-items: flex-start;
}

.ts-uitk-event-row > .ts-key-value-label {
    width: 160px;
    min-width: 160px;
    flex-shrink: 0;
}

.ts-uitk-event-row > .ts-key-value-value {
    min-width: 0;
    white-space: normal;
}

.common-inspector--compact .ts-uitk-event-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 4px;
}

.common-inspector--compact .ts-uitk-event-row > .ts-key-value-label {
    width: auto;
    min-width: 0;
    margin-bottom: 1px;
}
