{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b163c510fb6f4523af4ee97905842f50",
    "m_Group": {
        "m_Id": "e1248e5c7129450d9188681a5a6d61ae"
    },
    "m_Name": "RotateAndMoveUVs (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -4691.20068359375,
            "y": -1117.5999755859375,
            "width": 268.80029296875,
            "height": 165.60003662109376
        }
    },
    "m_Slots": [
        {
            "m_Id": "8d630a981c134f1f80db35937aeaef3e"
        },
        {
            "m_Id": "8e62372ec742488daebde0bd4adc625f"
        },
        {
            "m_Id": "65cce157f788468cbb296907e25f0045"
        },
        {
            "m_Id": "d3199d5542144d5c9d0d64d0eaf3c3b0"
        },
        {
            "m_Id": "df19d8e39d234a88abd154d11034653d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "RotateAndMoveUVs",
    "m_FunctionSource": "9209f3e6f95c36942a37bdf89500f51b",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void RotateAndMoveUVs (float2 UV, float Angle, float Speed, float Time, out float2 RotatedUV)  \r\n{\r\n    // Convert Angle from Degrees to Radians\r\n    float rad = Angle * (3.14159265 / 180.0);\r\n    float cosA = cos(rad);\r\n    float sinA = sin(rad);\r\n    \r\n    // Shift UVs to rotate around center (0.5, 0.5)\r\n    UV -= float2(0.5, 0.5);\r\n    \r\n    // Apply 2D Rotation\r\n    float2 rotated = float2(\r\n        UV.x * cosA - UV.y * sinA,\r\n        UV.x * sinA + UV.y * cosA\r\n    );\r\n    \r\n    // Shift UVs back\r\n    rotated += float2(0.5, 0.5);\r\n    \r\n    // Move UVs along angle direction\r\n    float2 motion = float2(cosA, sinA) * Speed * Time;\r\n    RotatedUV = rotated + motion;\r\n}\r\n"
}

