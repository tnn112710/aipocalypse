/* Kroma Design System - Theme Tokens
 * Scoped for Unity 6+ UI Toolkit Editor
 */

:root, .kroma-root, .kroma-atmosphere-row {
    /* Color Palette - Dark Foundation */
    --kroma-color-bg-darkest: #191919;
    --kroma-color-bg-dark: #202020;
    --kroma-color-bg-card: #222222;
    --kroma-color-bg-card-header: #2e2e2e;
    --kroma-color-bg-input: #1d1d1d;
    --kroma-color-bg-hover: #353535;
    --kroma-color-bg-active: #1f1f1f;

    /* Borders */
    --kroma-color-border: #383838;
    --kroma-color-border-card: #434343;
    --kroma-color-border-subtle: #2b2b2b;
    --kroma-color-border-focus: #4d79ff;

    /* Typography */
    --kroma-color-text-primary: #ffffff;
    --kroma-color-text-secondary: #c0c0c0;
    --kroma-color-text-muted: #808080;
    --kroma-font-size-sm: 10px;
    --kroma-font-size-md: 12px;
    --kroma-font-size-lg: 13px;
    --kroma-font-size-title: 14px;

    /* Accent & State */
    --kroma-color-accent: #5b4de0;
    --kroma-color-accent-hover: #6e60ec;
    --kroma-color-accent-active: #4839cb;
    --kroma-color-danger: #8a2525;
    --kroma-color-danger-hover: #a82e2e;
    --kroma-color-danger-text: #ff8585;
    --kroma-color-success: #2e7d32;
    --kroma-color-brand-orange: #ffa83a;
    --kroma-color-slider-fill: #0A7AFF;

    /* Metrics & Spacing */
    --kroma-spacing-xs: 2px;
    --kroma-spacing-sm: 4px;
    --kroma-spacing-md: 8px;
    --kroma-spacing-lg: 12px;
    --kroma-spacing-xl: 16px;
    --kroma-radius-sm: 3px;
    --kroma-radius-md: 6px;
    --kroma-radius-lg: 8px;
    --kroma-radius-card: 16px;
    --kroma-header-height: 40px;
    --kroma-banner-height: 130px;
}
