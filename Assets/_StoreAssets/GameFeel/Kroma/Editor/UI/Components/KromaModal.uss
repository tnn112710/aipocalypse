/* Kroma Design System - Modal Component
 * Shared styling for dialogs, prompts, and confirmation modals.
 */

.kroma-modal-root {
    flex-direction: column;
    padding: 0;
    background-color: #222222;
    justify-content: flex-start;
}

/* --------------------------------------------------------------------------
 * Modal Top Card Header (Matches Kroma Scene Profile Top Card)
 * -------------------------------------------------------------------------- */
.kroma-modal-header {
    height: 46px;
    background-color: #141414;
    overflow: hidden;
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #2b2b2b;
    flex-shrink: 0;
}

.kroma-modal-header__bg {
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 80px;
    background-image: url("../../Resources/UI/kroma-top-bg.png");
}

.kroma-modal-header__image {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    --unity-image: url("../../Resources/UI/header-Kroma-profile.png");
    flex-shrink: 0;
    margin-right: 12px;
}

.kroma-modal-header__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffa83a;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
}

/* --------------------------------------------------------------------------
 * Modal Body & Controls
 * -------------------------------------------------------------------------- */
.kroma-modal-content {
    padding: 16px;
    flex-direction: column;
    justify-content: flex-start;
}

.kroma-modal-body {
    font-size: 12px;
    color: #dcdcdc;
    white-space: normal;
    margin-bottom: 12px;
    flex-shrink: 0;
}



/* Action Buttons */
.kroma-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 16px;
    flex-shrink: 0;
}

.kroma-modal-btn {
    height: 28px;
    min-width: 100px;
    padding-left: 14px;
    padding-right: 14px;
    margin-left: 8px;
    font-size: 12px;
}

.kroma-modal-btn--accent {
    background-color: #ffa83a;
    border-color: #ffb85a;
    color: #111111;
    -unity-font-style: bold;
}

.kroma-modal-btn--accent:hover {
    background-color: #ffb85a;
    border-color: #ffc97a;
    color: #000000;
}

.kroma-modal-btn--accent:active {
    background-color: #e5932a;
    color: #000000;
}

.kroma-modal-btn:disabled,
.kroma-modal-btn--accent:disabled {
    opacity: 0.5;
    background-color: #2a2a2a;
    border-color: #383838;
    color: #777777;
}

/* --------------------------------------------------------------------------
 * Modal Box (Group of options / checkboxes)
 * -------------------------------------------------------------------------- */
.kroma-modal-box {
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #2b2b2b;
    border-radius: 6px;
    padding: 12px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.kroma-modal-box__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #aaaaaa;
    margin-bottom: 8px;
    padding: 0;
}

.kroma-modal-toggle-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 3px;
    margin-bottom: 3px;
    min-height: 22px;
}

.kroma-modal-toggle-row .kroma-toggle {
    flex-grow: 1;
    margin: 0;
}

.kroma-modal-badge--applied {
    font-size: 10px;
    color: #888888;
    background-color: #242424;
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 8px;
    align-self: center;
}

/* --------------------------------------------------------------------------
 * Clone Modal Preview & Input
 * -------------------------------------------------------------------------- */
.kroma-modal-clone-preview {
    flex-direction: row;
    align-items: center;
    padding: 10px;
}

.kroma-modal-clone-thumb {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    margin-right: 12px;
    background-color: #141414;
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}

.kroma-modal-clone-info {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.kroma-modal-box__subtitle {
    font-size: 10px;
    color: #888888;
    margin-bottom: 2px;
}

.kroma-modal-clone-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

.kroma-modal-field-group {
    margin-top: 10px;
    margin-bottom: 6px;
    flex-direction: column;
}

.kroma-modal-field-label {
    font-size: 11px;
    color: #cccccc;
    margin-bottom: 4px;
}

.kroma-modal-input {
    margin: 0;
}

.kroma-modal-input .unity-base-text-field__input {
    background-color: #141414;
    border-color: #333333;
    border-radius: 4px;
    border-width: 1px;
    padding: 6px 8px;
    color: #ffffff;
    font-size: 12px;
}

.kroma-modal-input:focus .unity-base-text-field__input {
    border-color: #ffa83a;
}


