      m_Items: []
  - m_Id: 2881887645723
    m_Localized: "V\u1EC1 menu ch\xEDnh?\nTi\u1EBFn tr\xECnh t\u1EEB l\u1EA7n l\u01B0u cu\u1ED1i s\u1EBD m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 2881887645724
    m_Localized: "Ghi \u0111\xE8 {0}?\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840000
    m_Localized: "T\u1EA3i {0}?\nTi\u1EBFn tr\xECnh t\u1EEB l\u1EA7n l\u01B0u cu\u1ED1i s\u1EBD m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840001
    m_Localized: "X\xF3a {0}?\nKh\xF4ng th\u1EC3 ho\xE0n t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840002
    m_Localized: "\u0110ang ch\u01A1i {0}  \xB7  {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840003
