    m_Localized: "B\u1EA3n l\u01B0u h\u1ECFng (thi\u1EBFu header)"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840018
    m_Localized: "L\u01B0u t\u1EEB phi\xEAn b\u1EA3n m\u1EDBi h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840019
    m_Localized: "\u0110\u1ECBnh d\u1EA1ng l\u01B0u c\u0169 (v{0})"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840020
    m_Localized: "B\u1EA3n l\u01B0u h\u1ECFng"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840021
    m_Localized: "\u0110\xE3 l\u01B0u game  \xB7  {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840022
    m_Localized: "T\u1EF1 \u0111\u1ED9ng l\u01B0u  \xB7  {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840023
    m_Localized: "Ch\u01B0a v\xE0o game"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840024
    m_Localized: "\u0110ang t\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840025
    m_Localized: "Kh\xF4ng c\xF3 ng\u01B0\u1EDDi ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840026
    m_Localized: "\u0110ang g\u1EE5c, kh\xF4ng l\u01B0u \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840027
    m_Localized: "\u0110ang \u0111\u1ED9t k\xEDch, kh\xF4ng l\u01B0u \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840028
    m_Localized: "\u0110ang t\u1EA3i r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840029
    m_Localized: "Kh\xF4ng m\u1EDF \u0111\u01B0\u1EE3c c\u1EA3nh {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840030
    m_Localized: "\u0110ang t\u1EA3i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840031
    m_Localized: "{0} b\u1ECB h\u1ECFng: \u0111ang t\u1EA3i b\u1EA3n d\u1EF1 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840032
    m_Localized: "Game m\u1EDBi \u1EDF {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840033
    m_Localized: "\u0110ang t\u1EA3i b\u1EA3n th\u1EED nghi\u1EC7m"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840034
    m_Localized: "Ch\u01B0a t\u1EF1 l\u01B0u: ch\u01B0a c\xF3 \xF4 l\u01B0u (menu t\u1EA1m d\u1EEBng, L\u01B0u game)"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840035
    m_Localized: "Ch\u01B0a ch\u1ECDn \xF4 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840036
    m_Localized: "Kh\xF4ng c\xF3 \xF4 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840037
    m_Localized: "\u0110ang l\u01B0u v\xE0o {0}..."
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840038
    m_Localized: "L\u01B0u th\u1EA5t b\u1EA1i: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840039
    m_Localized: "\u0110\xE3 t\u1EF1 l\u01B0u v\xE0o {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840040
    m_Localized: "\u0110\xE3 l\u01B0u v\xE0o {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840041
    m_Localized: " ({0} h\u1EC7 th\u1ED1ng gi\u1EEF tr\u1EA1ng th\xE1i l\u01B0u c\u0169: xem console)"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840042
    m_Localized: "\u0110ang t\u1EA3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840043
    m_Localized: XU
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840044
    m_Localized: "TRANG B\u1ECA"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840045
    m_Localized: "X\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840046
    m_Localized: "L\u1EA5y h\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840048
    m_Localized: "Ba l\xF4 ({0}/{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840049
    m_Localized: "N\u1EB7ng {0:1} / {1:1} kg"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840050
    m_Localized: "H\u1EBFt ch\u1ED7"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840051
    m_Localized: "Kh\xF4ng c\xF3 \xF4 trang b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840052
    m_Localized: "Ba l\xF4 \u0111\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840053
    m_Localized: "\u0110ang l\u1EE5c so\xE1t..."
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840054
    m_Localized: "D\u1ECDn tr\u1ED1ng c\xE1c \xF4 th\xEAm c\u1EE7a ba l\xF4 tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840055
    m_Localized: "L\u01B0\u1EE3t d\xF9ng {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2881891840056
    m_Localized: "Gi\xE1 tr\u1ECB {0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 371587535687680
    m_Localized: "Kh\xF4ng l\u1EAFp v\u1EEBa s\xFAng n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047808
    m_Localized: "B\u1EA5m v\xE0o m\u1ED9t kh\u1EA9u s\xFAng \u0111\u1EC3 l\u1EAFp ph\u1EE5 ki\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047809
    m_Localized: "B\u1EA5m v\xE0o m\u1ED9t m\xF3n \u0111\u1ED3 \u0111\u1EC3 xem"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047810
    m_Localized: '{0}   |   {1:0.##} kg   |   {2:N0} xu'
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047811
    m_Localized: "K\xE9o \u0111\u1EC3 xoay, cu\u1ED9n \u0111\u1EC3 ph\xF3ng to"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047812
    m_Localized: "S\xE1t th\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047813
    m_Localized: "T\u1ED1c \u0111\u1ED9 b\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047814
    m_Localized: "B\u0103ng \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047815
    m_Localized: "Th\u1EDDi gian n\u1EA1p"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047816
    m_Localized: "T\u1EA7m b\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047817
    m_Localized: "T\u1ED1c \u0111\u1ED9 \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047818
    m_Localized: "Gi\u1EADt d\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047819
    m_Localized: "Gi\u1EADt ngang"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047820
    m_Localized: "Th\u1EDDi gian ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047821
    m_Localized: "\u0110\u1ED9 t\u1ECFa"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047822
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047823
    m_Localized: "C\xE2n n\u1EB7ng"
    m_Metadata:
      m_Items: []
  - m_Id: 371587565047824
    m_Localized: "Ph\xF3ng \u0111\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 394527992008704
    m_Localized: "\u0110\u1ED9 t\u1ECFa khi b\u1EAFn h\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3466810428051456
    m_Localized: "\xD4 {0} ch\u1EC9 ch\u1EE9a s\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 3466810486771712
    m_Localized: "\xD4 {0} ch\u1EC9 ch\u1EE9a v\u0169 kh\xED c\u1EADn chi\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 3466810486771713
    m_Localized: "\xD4 {0} ch\u1EC9 ch\u1EE9a v\u1EADt ph\u1EA9m d\xF9ng \u0111\u01B0\u1EE3c v\xE0 d\u1EE5ng c\u1EE5"
