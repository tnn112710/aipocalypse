#pragma kernel CSMain

#include "Packages/space.distantlands.cozyweather.core/Runtime/Rendering/Shaders/Helpers/Reprojection.hlsl"

RWTexture3D<float4> CZY_FogIntegration;
Texture3D<float4>   CZY_FogAccumulation;
SamplerState        czy_fog_linear_clamp_sampler;

float3 CZY_FogVolumeSize;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= uint(CZY_FogVolumeSize.x) || id.y >= uint(CZY_FogVolumeSize.y))
        return;

    float3 scatteredLight  = float3(0, 0, 0);
    float  transmittance   = 1.0;
    float  lastDepth       = 0.0;
    float accumulatedFog = 0;

    for (int z = 0; z < (int)CZY_FogVolumeSize.z; z++)
    {
        uint3  voxel = uint3(id.x, id.y, z);
        float3 uvw   = VoxelToUVW(voxel, CZY_FogVolumeSize);

        float4 accumulated  = CZY_FogAccumulation.SampleLevel(czy_fog_linear_clamp_sampler, uvw, 0);
        float3 inScatter    = accumulated.rgb;
        float  extinction   = max(accumulated.a, 0.0); 

        float currentDepth  = ExponentialDepth(uvw.z) * CZY_Fog_Volumetric_MaxDistance;
        float stepDistance  = currentDepth - lastDepth;
        lastDepth           = currentDepth;

        float slabTransmittance = exp(-extinction * stepDistance);

        float3 scatterContrib = (extinction > 1e-6)
            ? inScatter * (1.0 - slabTransmittance) / extinction
            : inScatter * stepDistance; 

        scatteredLight += transmittance * scatterContrib;
        transmittance  *= slabTransmittance;
        accumulatedFog += accumulated.a * 0.1 * stepDistance;

        CZY_FogIntegration[voxel] = float4(accumulated.xyz, accumulatedFog);
    }
}