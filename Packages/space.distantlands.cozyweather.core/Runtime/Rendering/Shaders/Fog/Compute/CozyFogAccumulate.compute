#pragma kernel CSMain

#include "Packages/space.distantlands.cozyweather.core/Runtime/Rendering/Shaders/Helpers/Reprojection.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/CommonMaterial.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

#pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE
#pragma multi_compile _ MAIN_LIGHT_CALCULATE_SHADOWS
#pragma multi_compile_fragment _ _ADDITIONAL_LIGHTS
#pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS
#pragma multi_compile_fragment _ _SHADOWS_SOFT
#pragma multi_compile_fragment _ _SCREEN_SPACE_OCCLUSION
#pragma multi_compile _ _LIGHT_COOKIES

RWTexture3D<float4> CZY_FogVolume;
Texture3D<float4> CZY_FogVolumePrevious;
SamplerState czy_fog_linear_clamp_sampler;

float3 CZY_FogVolumeSize;
float3 CZY_FogVolumeFroxelSize;

float4x4 CZY_PrevViewMatrix;
float3 CZY_PrevCameraPos;
float CZY_TemporalWeight;

float FogDensity(float3 worldPos) {

    // Can be edited to change fog density based on world pos. For now, leave constant
    return 0.1;
}

float GetShadowAmount(float3 worldPos) {
    float4 shadowCoord = TransformWorldToShadowCoord(worldPos);
    Light mainLight = GetMainLight(shadowCoord);
    return mainLight.shadowAttenuation;
}


[numthreads(8,8,8)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= uint(CZY_FogVolumeSize.x) || id.y >= uint(CZY_FogVolumeSize.y) || id.z >= uint(CZY_FogVolumeSize.z))
        return;

    float3 uvw = VoxelToUVW(id, CZY_FogVolumeSize);

    float3 r = hammersley[GetID(id)]- 0.5;
    uvw = saturate(uvw + (r * CZY_FogVolumeFroxelSize));

    float3 wsPosition = UVWToWorldSpace(uvw);
    float3 vsPosition = UVWToViewSpace(uvw);

    float fogDensity = FogDensity(wsPosition);
    float lighting = GetShadowAmount(wsPosition);

    float4 currentColor = float4(1, 1, 1, fogDensity * lighting);

    float4 vsPositionPrevious4 = mul(CZY_PrevViewMatrix, float4(wsPosition, 1.0));
    float3 vsPositionPrevious = float3(vsPositionPrevious4.x, vsPositionPrevious4.y, -vsPositionPrevious4.z);
    float3 uvwPrevious = ViewSpaceToUVW(vsPositionPrevious);

    bool outOfBounds = any(uvwPrevious < 0.0) || any(uvwPrevious > 1.0);

    if (! outOfBounds) {
        float4 history = CZY_FogVolumePrevious.SampleLevel(sampler_LinearClamp, uvw, 0);
        float weight = CZY_TemporalWeight;
        currentColor = lerp(currentColor, history, weight);
    }

    CZY_FogVolume[id.xyz]= currentColor;
}