{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "765a22f31a51481ea97904dcd5e43e0e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetMainLightData (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -732.666748046875,
            "y": 552.0,
