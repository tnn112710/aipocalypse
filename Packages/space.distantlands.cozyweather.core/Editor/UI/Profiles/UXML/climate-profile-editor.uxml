                <uie:PropertyField binding-path="spring.climateInformation.temperature.low" label="High Temperature"/>
                <uie:PropertyField binding-path="spring.climateInformation.humidity.high" label="Max Humidity"/>
                <uie:PropertyField binding-path="spring.climateInformation.humidity.low" label="Min Humidity"/>
