<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/space.distantlands.cozyweather.core/Editor/UI/Globals.uss?fileID=7433441132597879392&amp;guid=60b39676bc45100478c0c8a083850788&amp;type=3"/>
    <DistantLands.Cozy.EditorScripts.Graph>
        <ui:VisualElement name="seasonal-graph" class="section-bg" style="height: 120px;"/>
    </DistantLands.Cozy.EditorScripts.Graph>
    <ui:DropdownField label="" choices="Temperature,Humidity,Pressure,UV Index,Air Quality" index="0" name="graphType"/>
    <ui:Label text="Seasons" class="h1"/>
    <ui:TabView class="climate-tabs">
        <ui:Tab icon-image="project://database/Packages/space.distantlands.cozyweather.core/Editor/Resources/COZY%20Icons/Winter.png?fileID=2800000&amp;guid=26a51d65787fad44b94d367181461c6a&amp;type=3#Winter" label="Winter">
            <ui:Label text="Winter" class="h2"/>
            <ui:VisualElement class="section-bg" style="flex-grow: 1;">
                <uie:PropertyField binding-path="winter.startDay"/>
                <uie:PropertyField binding-path="winter.climateInformation.temperature.high" label="High Temperature"/>
                <uie:PropertyField binding-path="winter.climateInformation.temperature.low" label="High Temperature"/>
                <uie:PropertyField binding-path="winter.climateInformation.humidity.high" label="Max Humidity"/>
                <uie:PropertyField binding-path="winter.climateInformation.humidity.low" label="Min Humidity"/>
                <uie:PropertyField binding-path="winter.climateInformation.pressure.high" label="Max Pressure"/>
                <uie:PropertyField binding-path="winter.climateInformation.pressure.low" label="Min Pressure"/>
                <uie:PropertyField binding-path="winter.climateInformation.uvIndex.high" label="Max UV Index"/>
                <uie:PropertyField binding-path="winter.climateInformation.airQuality.high" label="Max Air Quality"/>
                <uie:PropertyField binding-path="winter.climateInformation.airQuality.low" label="Min Air Quality"/>
            </ui:VisualElement>
        </ui:Tab>
        <ui:Tab icon-image="project://database/Packages/space.distantlands.cozyweather.core/Editor/Resources/COZY%20Icons/Spring.png?fileID=2800000&amp;guid=be5e8d0d69f33bf4dae147981b835b20&amp;type=3#Spring" label="Spring">
            <ui:Label text="Spring" class="h2"/>
            <ui:VisualElement class="section-bg" style="flex-grow: 1;">
