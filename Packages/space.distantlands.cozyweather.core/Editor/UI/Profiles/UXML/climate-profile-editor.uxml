        <ui:Tab icon-image="project://database/Packages/space.distantlands.cozyweather.core/Editor/Resources/COZY%20Icons/Summer.png?fileID=2800000&amp;guid=2edfa891fbb86fc4eb52d8f518255a42&amp;type=3#Summer" label="Summer">
