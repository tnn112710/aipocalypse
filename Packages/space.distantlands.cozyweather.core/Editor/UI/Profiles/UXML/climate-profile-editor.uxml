                <uie:PropertyField binding-path="spring.climateInformation.uvIndex.high" label="Max UV Index"/>
                <uie:PropertyField binding-path="spring.climateInformation.airQuality.high" label="Max Air Quality"/>
                <uie:PropertyField binding-path="spring.climateInformation.airQuality.low" label="Min Air Quality"/>
