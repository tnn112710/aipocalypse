}

.forecastablePanel #titleContainer {
    align-items: center;
    justify-content: center;
    flex-direction: row;
    margin-top: 20px;
    margin-right: 6px;
    margin-bottom: 8px;
    margin-left: 6px;
    -unity-text-align: upper-center;
