:root {
    --good-bg: rgba(0, 255, 100, 0.13);
    --good: rgba(0, 255, 100, 0.75);
    --warning-bg: rgba(255, 128, 0, 0.13);
    --warning: rgba(255, 128, 0, 0.75);
    --error-bg: rgba(255, 0, 0, 0.13);
    --error: rgba(255, 0, 0, 0.75);
    --dev-bg: rgba(0, 128, 255, 0.13);
    --dev: rgba(0, 255, 255, 0.75);
    --selected: rgba(98, 144, 199, 0.77);
    --selected-bg: rgba(37, 75, 120, 0.64);
    --selected-bg-light: rgba(108, 148, 196, 0.35);
}

Label {
    white-space: nowrap;
}

.hidden {
    display: none;
}

.h1 {
    font-size: 18px;
    margin-bottom: 8px;
    margin-top: 8px;
    -unity-font-style: bold;
}

.h2 {
    font-size: 14px;
    margin-bottom: 5px;
    margin-top: 15px;
    -unity-font-style: bold;
}

.p {
    margin-bottom: 4px;
    margin-top: 5px;
}

.h-full {
    height: 100%;
}

.w-full {
    width: 100%;
}

.h-lg {
    height: 150px;
}

.h-md {
    height: 100px;
}

.h-sm {
    height: 50px;
}

.p-0 {
    padding: 0;
}

.indented {
    padding-left: 16px;
}

.m-0 {
    margin: 0;
}

.m-4 {
    margin: 16px;
}

.mb-lg {
    margin-bottom: 20px;
}

.line-below {
    margin-bottom: 10px;
}

.mt-lg {
    margin-top: 20px;
}

.mt-md {
    margin-top: 10px;
}

.flex-row {
    flex-direction: row;
}

.flex-col {
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.font-bold {
    -unity-font-style: bold;
}

.module-toolbar {
    justify-content: flex-start;
    align-items: center;
}

.module-toolbar #icon {
    width: 20px;
    height: 20px;
}

.module-toolbar #back-button {
    width: 20px;
    padding-right: 4px;
    padding-left: 4px;
}

.module-toolbar #title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

.section-bg {
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 5px;
    padding-right: 7px;
    padding-bottom: 5px;
    padding-left: 15px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    background-color: rgb(45, 45, 45);
    margin-right: 6px;
    margin-left: 6px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: 10px;
}

.split-widget {
    flex-direction: row;
}

.split-widget VisualElement {
    width: 50%;
    height: 100%;
    margin: 2px;
}

.graph-section {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.half-graph-section {
    width: 50%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.style-selector-button {
    border-radius: 15px;
    margin: 2px;
    width: 100px;
    height: 100px;
    justify-content: flex-end;
}

.style-selector-button.active {
    border-width: 0;
    border-bottom-width: 5px;
    border-color: rgba(50, 210, 255, 0.83);
}

.style-selector-button.tall {
    height: 200px;
}

.style-selector-button:hover Image {
    left: -15px;
    top: -15px;
    right: -15px;
    bottom: -15px;
}

.style-selector-button Image {
    overflow: hidden;
    position: absolute;
    left: -5px;
    top: -5px;
    right: -5px;
    bottom: -5px;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.style-selector-button Label {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    color: rgb(87, 87, 87);
}

.style-selector-button Label.bright {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    color: rgb(235, 235, 235);
}

.cozy-profile {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}

.cozy-profile ObjectField {
    flex-grow: 1;
    flex-shrink: 1;
}

.cozy-profile #clone-profile {
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
}

.cozy-profile #new-profile {
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
}

.toggle-box VisualElement {
    display: none;
}

.toggle-box #icon {
    display: flex;
}

.toggle-box {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 3px;
    padding: 3px;
    background-color: var(--unity-colors-button-background);
    border-color: var(--unity-colors-button-border);
    border-width: 1px;
    border-radius: 3px;
}

.toggle-box:checked {
    background-color: var(--unity-colors-button-background-pressed);
}

.toggle-box:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.toggle-box:checked:hover {
    background-color: var(--unity-colors-button-background-hover_pressed);
}

.swatch {
    flex-direction: row;
    margin-right: 5px;
    margin-left: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.swatch Label {
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    margin-right: 5px;
    margin-left: 5px;
}

.swatch VisualElement {
    width: 15px;
    height: 15px;
}

.banner {
    height: 120px;
    overflow: hidden;
    flex-direction: row;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    flex-shrink: 0;
}

.banner #banner-icon {
    background-image: resource("Promo/Distant Lands Watermark");
    width: 52px;
    height: 52px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.banner #background-container {
    left: -5px;
    top: -5px;
    right: -5px;
    bottom: -5px;
    position: absolute;
    justify-content: center;
    align-items: center;
}

.banner #background-image {
    min-width: 110%;
    min-height: 110%;
    background-color: rgba(0, 0, 0, 0.6);
    -unity-background-image-tint-color: rgb(185, 185, 185);
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.banner #banner-content {
    flex-direction: row;
    align-items: center;
}

.banner #banner-title {
    -unity-font-style: bold;
    font-size: 33px;
    white-space: nowrap;
}

.banner #banner-subtitle {
    font-size: 14px;
    white-space: nowrap;
}

.banner #banner-text-container {
    margin-left: 5px;
}

.offset-label {
    -unity-text-align: upper-right;
}

.hover-effect:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.hidden-text {
    color: rgba(210, 210, 210, 0);
    font-size: 0.001px;
}

.hide-element-title .unity-object-field__label {
    opacity: 1;
    display: none;
}

.tab-group {
    flex-direction: row;
    height: 25px;
    transition-duration: 0.1s;
}

.unity-toolbar.toolbar {
    background-color: rgb(31, 31, 31);
}

.toolbar .unity-toolbar-button {
    background-color: rgb(31, 31, 31);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
}

.toolbar .unity-toolbar-button:hover {
    background-color: rgb(63, 63, 63);
}

.tab-group > Button {
    flex-direction: row-reverse;
    height: 25px;
    transition-duration: 0.1s;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    justify-content: center;
}

.tab-group > Button:hover {
    background-color: rgba(57, 57, 57, 0.42);
}

.tab-group > .selected {
    background-color: rgb(57, 57, 57);
}

.status-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.tab-group > .selected:hover {
    background-color: rgb(77, 77, 77);
}

.toolbar .unity-toolbar-button:focus {
    background-color: rgb(63, 63, 63);
    border-bottom-width: 1px;
    border-right-width: 0;
    border-left-width: 0;
}

.hidden {
    display: none;
}

.shown {
    display: flex;
}

.tooltip .icon {
    background-image: resource("COZY Icons/Info");
    width: 20px;
    height: 20px;
    margin-right: 7px;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    -unity-background-image-tint-color: rgb(104, 163, 223);
}

.tooltip.pass .icon {
    background-image: resource("COZY Icons/Pass");
    -unity-background-image-tint-color: rgb(60, 252, 92);
}

.tooltip.fail .icon {
    background-image: resource("COZY Icons/Error");
    -unity-background-image-tint-color: rgb(252, 60, 60);
}

.tooltip.warning .icon {
    background-image: resource("COZY Icons/Warning");
    -unity-background-image-tint-color: rgb(252, 172, 60);
}

.unity-base-field__aligned {
}

.nav-btn {
    -unity-text-align: upper-right;
    font-size: 14px;
    padding-top: 7px;
    padding-right: 6px;
    padding-bottom: 7px;
    padding-left: 4px;
    -unity-font-style: normal;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(161, 161, 161);
}

.nav-btn:hover {
    background-color: rgba(108, 108, 108, 0.39);
    color: rgb(247, 247, 247);
}

.nav-btn.active {
    background-color: rgb(61, 114, 154);
    color: rgb(255, 255, 255);
}

#background-image.main {
    background-image: resource("Banners/Cozy Weather");
    -unity-background-scale-mode: scale-and-crop;
}

.module-list {
    background-color: rgba(0, 0, 0, 0.18);
    flex-direction: row;
    flex-wrap: wrap;
    border-bottom-color: rgba(0, 0, 0, 0.13);
    border-bottom-width: 2px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-right: 4px;
    padding-left: 4px;
    justify-content: center;
}

.module-icon > VisualElement {
    height: 45px;
    width: 45px;
    background-color: rgba(172, 172, 172, 0.27);
    background-size: 100% 100%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-color: rgba(0, 0, 0, 0.19);
    border-left-color: rgba(0, 0, 0, 0.19);
    border-right-color: rgba(0, 0, 0, 0.19);
    border-top-color: rgba(0, 0, 0, 0.19);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-property: background-color;
    transition-duration: 0.1s;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 15px;
    margin-left: 5px;
    justify-content: center;
}

.settings-icon {
    height: 34px;
    width: 34px;
    background-color: rgba(172, 172, 172, 0.27);
    background-size: 100% 100%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-color: rgba(0, 0, 0, 0.19);
    border-left-color: rgba(0, 0, 0, 0.19);
    border-right-color: rgba(0, 0, 0, 0.19);
    border-top-color: rgba(0, 0, 0, 0.19);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-property: all;
    transition-duration: 0.1s;
    margin-top: 5px;
    margin-right: 8px;
    margin-bottom: 15px;
    margin-left: 8px;
    justify-content: center;
}

.module-icon.active > VisualElement {
    background-color: rgba(255, 255, 255, 0.3);
}

.module-icon.active > VisualElement:hover {
    background-color: rgba(255, 255, 255, 0.45);
}

.settings-icon:hover {
    background-color: rgba(220, 220, 220, 0.27);
}

.module-icon > VisualElement:hover {
    background-color: rgba(220, 220, 220, 0.27);
}

.module-icon {
    transition-property: all;
    transition-duration: 0.1s;
    transition-timing-function: linear;
}

.module-icon:hover {
    padding-right: 8px;
    padding-left: 8px;
}

.module-icon > VisualElement Label {
    position: absolute;
    bottom: -16px;
    -unity-font-style: bold;
    align-items: center;
    align-self: center;
    font-size: 8px;
    color: rgb(141, 141, 141);
}

.settings-icon Label {
    position: absolute;
    bottom: -16px;
    -unity-font-style: bold;
    align-items: center;
    align-self: center;
    font-size: 8px;
    color: rgb(141, 141, 141);
}

.space-auto {
    flex-grow: 1;
    width: 0;
    height: 0;
    min-height: 0;
    min-width: 0;
}

.context-bar {
}

.context-bar ToolbarSearchField {
    width: auto;
    min-width: 60px;
    max-width: 350px;
    flex-grow: 1;
    flex-basis: 60px;
}

.context-bar .context-button {
    width: 18px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-size: 70% 70%;
    flex-shrink: 0;
}

.context-bar .context-button:hover {
    background-color: rgba(255, 255, 255, 0.27);
}

.context-button.add-module {
    background-image: resource("d_Toolbar Plus More");
}

.context-button.menu {
    background-image: resource("d__Menu");
}

.context-button.add {
    background-image: resource("d_CreateAddNew");
}

.context-button.styles {
    background-image: resource("d_Grid.PaintTool@2x");
}

.context-button.help {
    background-image: resource("d_Help");
}

.context-button.settings {
    background-image: resource("d_Settings");
}

.context-button.back {
    background-image: resource("d_back");
    background-size: 50% 50%;
}

.context-button VisualElement {
    flex-grow: 1;
}

.context-bar .module {
    width: 15px;
    background-image: resource("COZY Icons/Atmosphere");
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: center;
}

.tooltip {
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(104, 163, 223, 0.47);
    border-right-color: rgba(104, 163, 223, 0.47);
    border-top-color: rgba(104, 163, 223, 0.47);
    border-bottom-color: rgba(104, 163, 223, 0.47);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgba(58, 94, 130, 0.47);
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    color: rgb(245, 245, 245);
}

.tooltip.warning {
    border-left-color: rgba(252, 172, 60, 0.47);
    border-right-color: rgba(252, 172, 60, 0.47);
    border-top-color: rgba(252, 172, 60, 0.47);
    border-bottom-color: rgba(252, 172, 60, 0.47);
    background-color: rgba(252, 172, 60, 0.25);
}

.tooltip.fail {
    border-left-color: rgba(252, 60, 60, 0.47);
    border-right-color: rgba(252, 60, 60, 0.47);
    border-top-color: rgba(252, 60, 60, 0.47);
    border-bottom-color: rgba(252, 60, 60, 0.47);
    background-color: rgba(252, 60, 60, 0.25);
}

.tooltip.pass {
    border-left-color: rgba(60, 252, 92, 0.47);
    border-right-color: rgba(60, 252, 92, 0.47);
    border-top-color: rgba(60, 252, 92, 0.47);
    border-bottom-color: rgba(60, 252, 92, 0.47);
    background-color: rgba(60, 252, 92, 0.25);
}

.console-status-good {
    border-color: var(--good);
    background-color: var(--good-bg);
    color: var(--good);
}

.console-status-warning {
    border-color: var(--warning);
    background-color: var(--warning-bg);
    color: var(--warning);
}

.console-status-error {
    border-color: var(--error);
    background-color: var(--error-bg);
    color: var(--error);
}

.console-status-dev {
    border-color: var(--dev);
    background-color: var(--dev-bg);
    color: var(--dev);
}

.calendar {
    background-color: rgba(0, 0, 0, 0.33);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 2px;
    margin-right: 8px;
    margin-left: 8px;
}

.calendar .month-view {
    flex-direction: row;
    flex-wrap: wrap;
    top: auto;
    bottom: auto;
    overflow: hidden;
    visibility: visible;
    position: relative;
    flex-shrink: 0;
    justify-content: space-between;
    transition-property: top;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    margin-top: 2px;
}

.month-view > VisualElement {
    --width: 0;
    align-items: center;
    justify-content: center;
    width: 13%;
}

.month-view .date {
    --width: 0;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
    transition-duration: 0.1s;
}

.month-view .date Label {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}

.month-view .date.has-event #indicator {
    width: 5px;
    height: 5px;
    background-color: var(--selected);
    margin-top: 5px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    flex-shrink: 0;
}

.month-view .date #indicator {
    flex-direction: row;
    height: 10px;
}

.month-view .date.active {
    --width: 0;
    border-color: var(--selected-bg);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    transition-duration: 0.2s;
}

.month-view .date.selected {
    --width: 0;
    background-color: var(--selected-bg);
    transition-duration: 0.2s;
}

.month-view .date:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.month-view .date.active:hover {
    background-color: var(--selected-bg-light);
}

.month-view .date.selected:hover {
    background-color: var(--selected-bg-light);
}

.calendar #weekday-display {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: upper-center;
    border-bottom-color: rgba(255, 255, 255, 0.33);
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.33);
    border-right-color: rgba(255, 255, 255, 0.33);
    border-top-color: rgba(255, 255, 255, 0.33);
    padding-bottom: 5px;
    color: rgba(210, 210, 210, 0.67);
}

.calendar #month-info {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.calendar #month-info Label {
    -unity-font-style: bold;
    font-size: 16px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 10px;
    margin-left: 5px;
    padding: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    -unity-text-align: middle-left;
}

.calendar #month-info Label:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.calendar #month-view-mask {
    height: 45px;
    overflow: hidden;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.calendar #month-view-mask:hover {
}

.day-view {
}

.calendar #calendar-footer {
    height: 30px;
    flex-direction: row;
    flex-shrink: 0;
}

.nav-button {
    width: 20px;
    height: 20px;
    background-color: rgba(255, 255, 255, 0.15);
    background-size: 55% 55%;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    margin-right: 5px;
    margin-left: 5px;
}

.nav-button:hover {
    background-color: rgba(255, 255, 255, 0.25);
}

.nav-button#back {
    background-image: resource("d_back@2x");
}

.nav-button#forward {
    background-image: resource("d_forward@2x");
}

.day-view {
    margin-top: 10px;
    margin-bottom: 5px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgba(132, 132, 132, 0.11);
    padding-top: 10px;
    padding-bottom: 10px;
    margin-right: 8px;
    margin-left: 8px;
}

.day-view #day-info {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    padding-bottom: 5px;
    border-bottom-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(119, 119, 119, 0.77);
}

.day-view #day-title {
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    border-bottom-width: 0;
    padding-bottom: 5px;
    flex-shrink: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-left-width: 0;
}

.day-view #day-title #date {
    font-size: 24px;
}

.day-view #hourly-events {
    background-color: rgba(0, 0, 0, 0.28);
    flex-shrink: 0;
    min-height: 350px;
}

.day-view #all-day-events {
    flex-shrink: 0;
    height: 50px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.atmosphere-property-window #timeline-sections {
    margin-right: 15px;
    margin-left: 15px;
    justify-content: center;
    height: 30px;
}

#timeline-sections .timeline-section {
    width: 15px;
    height: 15px;
    position: absolute;
    translate: -50% 50%;
    left: 0%;
}

.timeline-section#night {
    background-image: resource("COZY Icons/Night");
    left: 0%;
}

.timeline-section#morning {
    background-image: resource("COZY Icons/Sunrise");
    left: 25%;
}

.timeline-section#day {
    background-image: resource("COZY Icons/Day");
    left: 50%;
}

.timeline-section#evening {
    background-image: resource("COZY Icons/Sunset");
    left: 75%;
}

.timeline-section#midnight {
    background-image: resource("COZY Icons/Night");
    left: 100%;
}

.atmosphere-property-window #timeline {
    margin-right: 0;
    margin-left: 0;
    border-top-color: rgba(255, 255, 255, 0.25);
    border-top-width: 1px;
    margin-top: 7px;
    margin-bottom: 20px;
    border-bottom-color: rgba(255, 255, 255, 0.25);
    border-bottom-width: 1px;
    height: 30px;
    justify-content: center;
}

#timeline .knob {
    width: 14px;
    height: 14px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-left-color: rgba(255, 255, 255, 0.38);
    border-right-color: rgba(255, 255, 255, 0.38);
    border-top-color: rgba(255, 255, 255, 0.38);
    border-bottom-color: rgba(255, 255, 255, 0.38);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    position: absolute;
    left: 0%;
    translate: -50% 0;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    background-color: rgb(152, 152, 152);
    top: 120%;
}

#clock-dots .knob {
    width: 20px;
    height: 20px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-left-color: rgba(255, 255, 255, 0.38);
    border-right-color: rgba(255, 255, 255, 0.38);
    border-top-color: rgba(255, 255, 255, 0.38);
    border-bottom-color: rgba(255, 255, 255, 0.38);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    position: absolute;
    left: 0%;
    translate: -50% 0%;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(152, 152, 152);
    transition-duration: 0.1s;
}

#timeline .knob:hover {
    background-color: rgb(196, 196, 196);
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
}

#clock-dots .knob:hover {
    background-color: rgb(196, 196, 196);
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
}

#timeline .knob.selected {
    background-color: rgb(120, 154, 196);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.72);
    border-right-color: rgba(255, 255, 255, 0.72);
    border-top-color: rgba(255, 255, 255, 0.72);
    border-bottom-color: rgba(255, 255, 255, 0.72);
}

#clock-dots .knob.selected {
    background-color: rgb(120, 154, 196);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.72);
    border-right-color: rgba(255, 255, 255, 0.72);
    border-top-color: rgba(255, 255, 255, 0.72);
    border-bottom-color: rgba(255, 255, 255, 0.72);
}

.module-category {
    margin-top: 5px;
    margin-bottom: 5px;
}

.module-category > Label {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.module-category-container {
    background-color: rgba(0, 0, 0, 0.54);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-evenly;
}

.module-category .module {
    width: 45%;
    height: 90px;
    justify-content: flex-start;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: var(--unity-colors-button-background);
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 5px;
    margin-left: 5px;
    min-width: 50px;
    max-width: 100%;
    flex-grow: 1;
    transition-duration: 0.1s;
    align-items: flex-start;
}

.module-category .module:hover {
    background-color: rgb(101, 101, 101);
}

.cozy-tab-view #unity-tab__header {
    flex-grow: 1;
    flex-shrink: 0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-items: center;
    justify-content: center;
}

.cozy-tab-view #unity-tab-view__header-container {
    flex-grow: 1;
    flex-shrink: 0;
    -unity-text-align: upper-center;
}

.rounded-field {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.atmosphere-property {
    flex-shrink: 0;
    flex-direction: row;
    height: 20px;
}

.atmosphere-property .rounded-field {
    border-color: rgba(0, 0, 0, 0.15);
    border-width: 1px;
}

.background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

#clock-sections .timeline-section {
    width: 15px;
    height: 15px;
    position: absolute;
    translate: 0% 0%;
}

.atmosphere-property .label-toggle {
    flex-direction: row;
    min-width: 150px;
    align-items: center;
    margin-left: 2px;
}

.atmosphere-property .field {
    flex-grow: 1;
    overflow: hidden;
    margin-top: 1px;
    margin-right: 5px;
    margin-bottom: 1px;
    margin-left: 1px;
}

.atmosphere-property .multi-field {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 3px;
    margin-bottom: 0;
    margin-left: 0;
}

.atmosphere-property .multi-field PropertyField {
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 0;
}

.atmosphere-property .multi-field Slider {
    flex-grow: 1;
}

.atmosphere-property .multi-field .unity-base-field {
    border-radius: 8px;
}

.atmosphere-property .multi-field .unity-base-field__input {
    border-radius: 8px;
}

.atmosphere-property .multi-field FloatInput {
    border-radius: 8px;
    padding-left: 5px;
}

.inline-btn {
    border-radius: 8px;
    margin-top: 0;
