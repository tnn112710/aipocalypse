}

.overrideFoldout {
    background-color: rgba(0, 0, 0, 0.18);
    margin-right: -5px;
    margin-left: -15px;
    height: 23px;
    justify-content: flex-start;
    flex-direction: row;
    border-bottom-color: rgb(0, 0, 0);
    border-bottom-width: 1px;
    margin-top: 1px;
    padding-right: 5px;
    padding-left: 16px;
    padding-top: 0;
    padding-bottom: 0;
}

.overrideFoldout #icon {
    width: 14px;
    height: 14px;
    margin-top: 4px;
    margin-right: 3px;
    margin-bottom: 4px;
    margin-left: 6px;
}

.overrideFoldout #context {
    background-image: resource("d__Menu");
}

.overrideFoldout #handles {
    background-image: resource("d_AvatarPivot");
}

.overrideFoldout #help {
    background-image: resource("d__Help");
}

.overrideFoldout #warning {
    background-image: resource("Warning");
}

.overrideFoldout .toolbarBtn {
    width: 16px;
    height: 16px;
    margin-top: 1px;
    margin-bottom: 1px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 1px;
    margin-left: 1px;
    -unity-background-image-tint-color: rgb(201, 201, 201);
    padding-right: 2px;
    padding-left: 2px;
    background-size: 15px 15px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.overrideFoldout #split {
    flex-grow: 1;
}

.overrideFoldout Label {
    -unity-font-style: bold;
    align-self: center;
}

.overrideFoldout:hover {
    background-color: rgba(29, 107, 152, 0.2);
}

.overrideFoldout .toolbarBtn:hover {
    background-color: rgba(123, 188, 226, 0.2);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.overrideFoldout.sunshafts #icon {
    background-image: resource("COZY Icons/Sunray Override");
}

.overrideFoldout.lighting #icon {
    background-image: resource("COZY Icons/Lighting Override");
}

.overrideFoldout.fog #icon {
    background-image: resource("COZY Icons/Fog Override");
}

.overrideFoldout.sky #icon {
    background-image: resource("COZY Icons/Sky Override");
}

.overrideFoldout.clouds #icon {
    background-image: resource("COZY Icons/Clouds Override");
}

.overrideFoldout.orientation #icon {
    background-image: resource("COZY Icons/Interactions");
}

.addStyleButton {
    position: absolute;
    top: 3px;
    right: 9px;
    width: 16px;
    height: 16px;
    background-image: resource("d_CreateAddNew");
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
}

.addStyleButton:hover {
    background-color: rgba(252, 252, 252, 0.2);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.styleToggle {
    height: 50px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.19);
    flex-shrink: 0;
}

.styleToggle #icon {
    width: 40px;
    height: 40px;
    margin-left: 10px;
    margin-bottom: 5px;
    margin-top: 5px;
    margin-right: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgb(0, 0, 0);
    flex-shrink: 0;
}

.styleToggle #checkmark {
    background-image: resource("COZY Icons/Check");
    display: none;
    width: 20px;
    height: 20px;
    position: absolute;
    right: 7px;
    align-self: center;
}

.styleToggle.active #checkmark {
    display: flex;
}

.styleToggle #title {
    margin-bottom: 0;
    -unity-font-style: bold;
    font-size: 14px;
}

.styleToggle #description {
    white-space: nowrap;
    text-overflow: ellipsis;
}

.styleToggle #textContainer {
    margin-top: 5px;
    margin-bottom: 5px;
}

.styleToggle:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.styleToggle.active:hover {
    background-color: var(--selected-bg-light);
}

.styleHeader {
    flex-direction: row;
    margin-top: 10px;
    margin-right: 5px;
}

.styleHeader Label {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 8px;
}

.styleTabs .unity-tab-view__content-viewport {
    flex-shrink: 0;
}

.styleToggle #overhead {
    font-size: 11px;
    margin-right: 10px;
    margin-left: 10px;
    padding-right: 6px;
    padding-left: 6px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-color: rgba(255, 255, 255, 0.28);
    color: rgb(255, 255, 255);
}

.styleToggle.Lightweight #overhead {
    background-color: var(--dev-bg);
    color: var(--dev);
    border-color: var(--dev);
}

.styleToggle.Normal #overhead {
    border-color: var(--good);
    color: var(--good);
    background-color: var(--good-bg);
}

.styleToggle.Heavy #overhead {
    border-color: var(--warning);
    background-color: var(--warning-bg);
    color: var(--warning);
}

.blackboard {
    background-color: var(--unity-colors-inspector_titlebar-border);
}

.panel {
    background-color: var(--unity-colors-window-background);
    width: 200px;
    margin-top: 2px;
    margin-right: 5px;
    margin-bottom: 2px;
    margin-left: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-width: 2px;
    border-left-color: rgb(29, 29, 29);
    border-right-color: rgb(29, 29, 29);
    border-top-color: rgb(29, 29, 29);
    border-bottom-color: rgb(29, 29, 29);
}

.forecastablePanel {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    margin-top: 80px;
