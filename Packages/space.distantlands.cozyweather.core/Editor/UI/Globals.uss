    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    overflow: hidden;
}

.profileDisplay #title {
    position: absolute;
    left: 14px;
    bottom: 33px;
    -unity-font-style: bold;
    font-size: 18px;
}

.profileDisplay #description {
    left: 14px;
    bottom: 10px;
    position: absolute;
    -unity-text-align: upper-left;
    height: 24px;
    width: 75%;
    text-overflow: ellipsis;
    white-space: normal;
    -unity-font-style: normal;
}

.profileDisplay #background {
    -unity-background-scale-mode: scale-and-crop;
    background-image: resource("Banners/Cozy Weather");
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    -unity-background-image-tint-color: rgb(153, 153, 153);
    filter: blur(2);
    transition-duration: 0.2s;
    scale: 1.05 1.05;
}

.profileDisplay #dropdown {
    position: absolute;
    right: 20px;
    width: 13px;
    background-image: var(--unity-icons-foldout-checked_pressed);
    top: 0;
    bottom: 0;
    justify-content: center;
    align-content: center;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(195, 195, 195);
    transition-duration: 0.1s;
}

.profileDisplay:hover #background {
    -unity-background-image-tint-color: rgb(229, 229, 229);
    scale: 1.1 1.1;
}

.profileDisplay:hover #dropdown {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.profileDisplay #glint {
    height: 200px;
    width: 20px;
    background-color: rgba(255, 255, 255, 0.255);
    position: absolute;
    top: -30px;
    left: -65px;
    rotate: 22deg;
    transition-timing-function: linear;
    transition-duration: 0.25s;
    transition-delay: 0.05s;
    transition-property: left;
}

.profileDisplay:hover #glint {
    left: 582px;
}

.detailsContainer {
    background-color: rgba(0, 0, 0, 0.102);
}

.detailsContainer #screenshot {
    height: 220px;
    background-color: rgb(36, 36, 36);
    -unity-background-scale-mode: scale-and-crop;
}

.atmosphereBrowserFooter {
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    height: 40px;
    flex-direction: row;
    justify-content: space-between;
}

.atmosphereBrowserFooter Button {
    width: 100px;
}

.detailsContainer #title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.detailsContainer #description {
    margin-left: 5px;
}

.atmosphereProfileOption {
    height: 40px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.055);
    margin-top: 3px;
    margin-right: 8px;
    margin-left: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    overflow: hidden;
}

.atmosphereProfileOption #label {
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-left;
    top: 0;
    bottom: 0;
    left: 5px;
    position: absolute;
}

.atmosphereProfileOption:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.atmosphereProfileOption #icon {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 80px;
    background-color: rgb(0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 18px;
    border-bottom-left-radius: 18px;
}

.atmosphereProfileOption.active {
    background-color: rgba(255, 255, 255, 0.216);
}

.searchContainer {
    flex-shrink: 0;
    height: 35px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.searchContainer ToolbarSearchField {
    flex-grow: 1;
}

.atmosphereProfileFoldout .unity-foldout__text {
    -unity-font-style: bold;
    font-size: 14px;
}

.atmosphereProfileFoldout {
    margin-top: 12px;
    margin-bottom: 5px;
}

.atmosphereProfileFoldout .atmosphereProfileOption {
    margin-left: -7px;
}

.startScreenButtonContainer {
}

.startScreenButtonContainer Button {
    margin-top: 1px;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    padding-top: 9px;
    padding-bottom: 9px;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    background-color: var(--unity-colors-box-border);
    border-right-color: rgba(85, 85, 85, 0);
    flex-direction: row;
    justify-content: space-between;
    transition-duration: 0.2s;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-right: 12px;
    padding-left: 12px;
}

.startScreenButtonContainer Button:hover {
    background-color: rgba(159, 159, 159, 0.145);
}

.startScreenButtonContainer Image {
    width: 16px;
    height: 16px;
    margin-top: 0;
    margin-right: 3px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 3px;
    transition-duration: 0.1s;
    opacity: 0.73;
}

.startScreenButtonContainer Button.active {
    background-color: rgba(86, 140, 180, 0.275);
    color: rgb(102, 192, 255);
}

.startScreenButtonContainer Button:hover Image {
    opacity: 1;
}

.startScreenButtonContainer Button.active:hover {
    background-color: rgba(96, 170, 226, 0.322);
}
