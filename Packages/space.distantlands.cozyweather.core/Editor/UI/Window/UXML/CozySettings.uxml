<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/space.distantlands.cozyweather.core/Editor/UI/Globals.uss?fileID=7433441132597879392&amp;guid=60b39676bc45100478c0c8a083850788&amp;type=3#Globals"/>
    <ui:VisualElement class="banner">
        <ui:VisualElement name="background-container">
            <ui:VisualElement name="background-image" class="main" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="banner-content">
            <ui:VisualElement name="banner-icon" style="flex-grow: 1;"/>
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Label text="COZY" name="banner-title"/>
                <ui:Label text="Stylized Weather" name="banner-subtitle"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <DistantLands.Cozy.EditorScripts.StatusMessage style="position: absolute; right: 0; bottom: 0;"/>
    </ui:VisualElement>
    <ui:ScrollView>
        <ui:VisualElement style="flex-grow: 1; padding-right: 3px; padding-left: 3px;">
            <ui:Label text="COZY" class="h1"/>
            <ui:VisualElement>
                <ui:Label text="Orientation" class="h2"/>
                <ui:VisualElement name="orientation"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="Units" class="h2"/>
                <ui:VisualElement name="units"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="Time" class="h2"/>
                <ui:VisualElement name="time"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="Editor Settings" class="h2"/>
                <ui:VisualElement name="editor"/>
                <ui:Label text="Calendar" class="h2"/>
                <ui:VisualElement name="calendar"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
