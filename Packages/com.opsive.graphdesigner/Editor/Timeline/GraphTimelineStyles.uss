.graph-timeline-panel {
    flex-grow: 1;
    min-height: 150px;
    background-color: rgb(35, 35, 35);
}

.graph-timeline-workspace {
    flex-grow: 1;
    min-height: 150px;
}

.graph-timeline-workspace-tabs,
.graph-timeline-workspace-header,
.graph-timeline-workspace-footer {
    flex-shrink: 0;
}

.graph-timeline-workspace-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.graph-timeline-workspace-sidebar {
    width: 230px;
    min-width: 180px;
    max-width: 360px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgb(25, 25, 25);
}

.graph-timeline-workspace-timeline {
    flex-grow: 1;
    min-width: 0;
}

.graph-timeline-toolbar {
    flex-shrink: 0;
    min-height: 24px;
}

.graph-timeline-title {
    -unity-font-style: bold;
    margin-left: 8px;
}

.graph-timeline-context {
    margin-left: 7px;
    color: rgb(155, 184, 210);
}

.graph-timeline-time {
    min-width: 66px;
    -unity-text-align: middle-right;
    padding-right: 6px;
}

.graph-timeline-status {
    flex-shrink: 0;
    min-height: 20px;
    padding-left: 8px;
    padding-top: 2px;
    color: rgb(180, 210, 235);
    background-color: rgba(45, 82, 108, 0.65);
}

.graph-timeline-error {
    color: rgb(255, 205, 195);
    background-color: rgba(115, 45, 38, 0.8);
}

.graph-timeline-warning {
    color: rgb(255, 226, 164);
    background-color: rgba(112, 78, 25, 0.8);
}

.graph-timeline-scroll {
    flex-grow: 1;
}

.graph-timeline-rows {
    position: relative;
    flex-grow: 1;
}

.graph-timeline-empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(145, 145, 145);
}

.graph-timeline-ruler-row,
.graph-timeline-row {
    flex-direction: row;
    flex-shrink: 0;
}

.graph-timeline-ruler-row {
    background-color: rgb(48, 48, 48);
    border-bottom-width: 1px;
    border-bottom-color: rgb(26, 26, 26);
}

.graph-timeline-ruler-corner {
    flex-shrink: 0;
    padding-left: 8px;
    padding-top: 3px;
    -unity-font-style: bold;
    border-right-width: 1px;
    border-right-color: rgb(28, 28, 28);
}

.graph-timeline-ruler {
    position: relative;
    flex-shrink: 0;
}

.graph-timeline-ruler-label {
    position: absolute;
    top: 2px;
    font-size: 9px;
    color: rgb(160, 160, 160);
}

.graph-timeline-channel-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-right: 3px;
    background-color: rgb(47, 47, 47);
    border-right-width: 1px;
    border-right-color: rgb(27, 27, 27);
    border-bottom-width: 1px;
    border-bottom-color: rgb(37, 37, 37);
}

.graph-timeline-channel-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.graph-timeline-channel-name {
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.graph-timeline-channel-button {
    width: 20px;
    height: 18px;
    min-width: 20px;
    min-height: 18px;
    padding-left: 1px;
    padding-right: 1px;
    margin-left: 1px;
    margin-right: 0;
    font-size: 9px;
}

.graph-timeline-channel-button-active {
    background-color: rgb(72, 115, 148);
    color: white;
}

.graph-timeline-canvas {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(40, 40, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 32, 32);
}

.graph-timeline-element {
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(255, 255, 255, 0.3);
    border-bottom-color: rgba(0, 0, 0, 0.65);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.graph-timeline-element:hover {
    border-left-color: white;
    border-right-color: white;
    border-top-color: white;
    border-bottom-color: white;
}

.graph-timeline-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 196, 64);
    border-right-color: rgb(255, 196, 64);
    border-top-color: rgb(255, 196, 64);
    border-bottom-color: rgb(255, 196, 64);
}

.graph-timeline-element-label {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 2px;
    overflow: hidden;
    white-space: nowrap;
    color: white;
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    -unity-text-outline-width: 1px;
}

.graph-timeline-content-image,
.graph-timeline-content,
.graph-timeline-samples {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.graph-timeline-point {
    rotate: 45deg;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.graph-timeline-range {
    opacity: 0.65;
}

.graph-timeline-overlap {
    border-top-color: rgb(255, 194, 92);
    border-bottom-color: rgb(255, 194, 92);
    border-top-width: 2px;
    border-bottom-width: 2px;
    opacity: 0.86;
}

.graph-timeline-diagnostic {
    opacity: 0.55;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.graph-timeline-certainty-estimated {
    opacity: 0.82;
}

.graph-timeline-certainty-unknown {
    opacity: 0.5;
}

.graph-timeline-certainty-observed {
    border-top-color: rgb(104, 230, 155);
}

.graph-timeline-resize-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: rgba(255, 255, 255, 0.25);
}

.graph-timeline-resize-left { left: 0; }
.graph-timeline-resize-right { right: 0; }

.graph-timeline-link-overlay {
    position: absolute;
    overflow: visible;
}

.graph-timeline-link {
    position: absolute;
}

.graph-timeline-link-label {
    position: absolute;
    min-width: 70px;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: rgb(215, 215, 220);
    background-color: rgba(35, 35, 35, 0.8);
}
